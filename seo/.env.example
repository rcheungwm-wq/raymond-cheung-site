# Copy to seo/.env (gitignored) and fill in ONE provider.
# seo/serp-check.mjs auto-detects: SerpAPI is preferred if both are set.

# --- Option A: SerpAPI (accurate, mirrors a real Google SG SERP) ---
# Free tier: 100 searches/month. https://serpapi.com/manage-api-key
SERPAPI_KEY=

# --- Option B: Google Programmable Search / Custom Search JSON API ---
# Free tier: 100 queries/day. Rougher than a real SERP but fine for trend direction.
# Key:  https://developers.google.com/custom-search/v1/introduction  (enable "Custom Search API")
# CX:   https://programmablesearchengine.google.com  -> create engine, "Search the entire web", copy the Search engine ID
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
